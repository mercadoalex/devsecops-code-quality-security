# syntax=docker/dockerfile:1
# -----------------------------------------------------------------------------
# DevSecOps course — shared VM base layer
# Produces a systemd-booting Ubuntu 24.04 rootfs suitable for iximiuz Firecracker
# microVMs. The three playground images (base/k8s/ai) all FROM this.
#
# Build (from repo root):
#   docker build --platform linux/amd64 \
#     -f rootfs/common/Dockerfile.vmbase \
#     -t devsecops-vmbase:latest rootfs
#
# Lessons applied from docs/BUILD_JOURNAL.md:
#   - Ubuntu 24.04 (apt is faster/better-cached than dnf under QEMU)
#   - systemd as PID 1, serial console on ttyS0, machine-id reset  (VM boot reqs)
#   - noble-backports pinned off to dodge the QEMU GPG bug
#   - laborant user (uid 1001) with passwordless sudo
#   - all root-owned file ops happen BEFORE switching USER
# -----------------------------------------------------------------------------
FROM --platform=linux/amd64 ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ARG LAB_USER=laborant

# Work around the noble-backports InRelease GPG failure seen under QEMU emulation.
RUN printf 'Package: *\nPin: release a=noble-backports\nPin-Priority: -1\n' \
      > /etc/apt/preferences.d/no-backports

# Core OS + VM boot requirements + common CLI tooling used across lessons.
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv udev kmod dbus \
      openssh-server sudo ca-certificates curl wget gnupg lsb-release \
      git jq unzip tar xz-utils zstd \
      iproute2 iputils-ping netcat-openbsd dnsutils procps \
      python3 python3-pip python3-venv pipx vim less \
    && rm -rf /var/lib/apt/lists/*

# yq (static binary — small, used by several lessons)
RUN curl -fsSL -o /usr/local/bin/yq \
      https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 \
    && chmod +x /usr/local/bin/yq

# Serial console for the Firecracker VM.
RUN systemctl enable getty@ttyS0.service || true

# Lab user with passwordless sudo.
RUN useradd --create-home --uid 1001 --shell /bin/bash ${LAB_USER} \
    && echo "${LAB_USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${LAB_USER} \
    && chmod 0440 /etc/sudoers.d/${LAB_USER} \
    && mkdir -p /home/${LAB_USER} \
    && chown -R ${LAB_USER}:${LAB_USER} /home/${LAB_USER}

# Enable pipx path for the lab user (tools installed via pipx land on PATH).
ENV PATH=/home/${LAB_USER}/.local/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Reset machine-id so each booted VM gets a fresh identity.
RUN rm -f /etc/machine-id /var/lib/dbus/machine-id \
    && ln -sf /etc/machine-id /var/lib/dbus/machine-id

# systemd is PID 1 inside the microVM.
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
